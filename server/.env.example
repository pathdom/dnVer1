DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=quan_ly_trung_tam
JWT_SECRET=
PORT=5000

# Generate JWT_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# After creating .env, run `node server/migrations/setup_auth.js` once.
# It adds password_hash columns to hoc_vien/nhan_vien and backfills them with
# a default password (see the migration file header for the exact values),
# and re-hashes the existing plaintext passwords in the admin table.
